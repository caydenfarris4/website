{
  "name": "website",
  "main": "worker.js",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // Blog reader pages go through the worker so it can inject each post's
    // Open Graph tags (title + excerpt) for link previews. Everything else
    // is served as plain static assets.
    "run_worker_first": [
      "/blog/the-work/reader.html",
      "/blog/ancient-paths/reader.html"
    ]
  }
}
